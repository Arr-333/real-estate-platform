{
  "name": "real-estate-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "prepare": "husky",
    "setup": "prisma migrate dev --seed"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix",
      "eslint --max-warnings=9999"
    ],
    "*.{json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.8",
    "@mui/x-data-grid": "^8.27.3",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^4.16.2",
    "@tinymce/tinymce-react": "^6.3.0",
    "apexcharts": "^5.9.0",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "bootstrap": "^5.3.8",
    "dotenv": "^17.2.1",
    "env-cmd": "^11.0.0",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.575.0",
    "mysql2": "^3.15.3",
    "next": "15.5.2",
    "next-auth": "^4.24.13",
    "nodemailer": "^7.0.11",
    "password-validator": "^5.3.0",
    "prisma": "^4.16.2",
    "react": "19.1.0",
    "react-apexcharts": "^2.0.1",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.62.0",
    "react-leaflet": "^5.0.0",
    "react-toastify": "^11.0.5",
    "swiper": "^12.1.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^4.16.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bcrypt": "^6.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "jsonwebtoken": "^9.0.3",
    "lint-staged": "^16.2.7",
    "mysql2": "^3.15.3",
    "next-auth": "^4.24.13",
    "nodemailer": "^7.0.11",
    "password-validator": "^5.3.0",
    "prettier": "^3.7.4",
    "prisma": "^4.16.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
