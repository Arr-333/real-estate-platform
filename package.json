{
  "name": "real-estate-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "prepare": "husky",
    "setup": "prisma migrate dev --seed"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix",
      "eslint --max-warnings=9999"
    ],
    "*.{json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "@mui/x-data-grid": "^8.28.6",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^7.8.0",
    "@tinymce/tinymce-react": "^6.3.0",
    "apexcharts": "^5.12.0",
    "axios": "^1.16.1",
    "bcrypt": "^6.0.0",
    "bootstrap": "^5.3.8",
    "dotenv": "^17.4.2",
    "env-cmd": "^11.0.0",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.16.0",
    "mysql2": "^3.22.3",
    "next": "16.2.6",
    "next-auth": "^4.24.14",
    "nodemailer": "^8.0.7",
    "password-validator": "^5.3.0",
    "prisma": "^7.8.0",
    "react": "19.2.6",
    "react-apexcharts": "^2.1.0",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.76.0",
    "react-leaflet": "^5.0.0",
    "react-toastify": "^11.1.0",
    "swiper": "^12.1.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^7.8.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bcrypt": "^6.0.0",
    "eslint": "^10",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "jsonwebtoken": "^9.0.3",
    "lint-staged": "^17.0.5",
    "mysql2": "^3.22.3",
    "next-auth": "^4.24.14",
    "nodemailer": "^8.0.7",
    "password-validator": "^5.3.0",
    "prettier": "^3.8.3",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "typescript": "^6"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
